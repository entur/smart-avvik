# disruptions/api/eval_static/ is intentionally NOT ignored: the /eval snapshots
# run BigQuery under a developer's ADC, so they can't be built in the image or CI.
# They are rendered offline (export_eval.sh) and committed, then shipped in the
# image. Refresh by running disruptions/api/export_eval.sh, then commit and push.

# Built into the image by the root Dockerfile's node stage; not committed.
disruptions/api/demo_static/
demo/reisedemo/node_modules/
demo/reisedemo/tsconfig.tsbuildinfo

# Built into the image by the root Dockerfile's node stage; not committed.
disruptions/api/varsel_static/
demo/avviksvarsel/node_modules/
demo/avviksvarsel/tsconfig.tsbuildinfo

# Built into the image by the root Dockerfile's node stage; not committed.
disruptions/api/historikk_static/
demo/varselhistorikk/node_modules/
demo/varselhistorikk/tsconfig.tsbuildinfo

# Built into the image by the root Dockerfile's node stage; not committed.
disruptions/api/meldinger_static/
demo/meldinger/node_modules/
demo/meldinger/tsconfig.tsbuildinfo

# Built into the image by the root Dockerfile's node stage; not committed. Was a single
# committed HTML page until 2026-09-01, when /togmelding moved onto Entur Linje — which
# needs the npm packages, and therefore a build step.
disruptions/api/togmelding_static/
demo/togmelding/node_modules/
demo/togmelding/tsconfig.tsbuildinfo

# Built into the image by the root Dockerfile's node stage; not committed.
disruptions/api/rushhistorikk_static/
demo/rushhistorikk/node_modules/
demo/rushhistorikk/tsconfig.tsbuildinfo

# The TypeScript packages a CLIENT vendors (integrations/). Neither goes into the image --
# .dockerignore excludes the whole directory -- and neither is published: KTD11 vendors them for
# the pilot. `dist/` is the DECLARED consumption shape (compiled CommonJS plus .d.ts) and is built
# by `npm run build`, so committing it would ship a copy that goes stale against src/ the first time
# anyone edits a source and forgets. The lockfiles ARE committed: the CI steps run `npm ci`, which
# fails without one. `contracts/` inside the client package is committed too -- it is a vendored,
# byte-parity-guarded copy of contracts/notifications/v1/, and the package must be self-contained
# when a client takes it.
integrations/notifications-client/node_modules/
integrations/notifications-client/dist/
integrations/firebase-notifications/node_modules/
integrations/firebase-notifications/dist/
**/tsconfig.tsbuildinfo

# Local avviksvarsel state file (durable state lives in the GCS bucket in prod).
disruptions/api/varsel_state.json

# Helm dependency archives (re-fetched by `helm dependency update`; Chart.lock is committed)
helm/**/charts/

# Terraform working files. State lives in gs://ent-gcs-tfa-kixavvik, never here.
# .terraform.lock.hcl is deliberately NOT ignored: it is committed so CI resolves
# the same provider versions a developer did.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/crash.log

# Understand Anything temp files
.ua/.trash-*/
.ua/intermediate/
.ua/tmp/
.ua/diff-overlay.json

# Local linked worktrees.
.worktrees/

# Firebase emulator working files. The emulator is only ever started by
# `firebase emulators:exec` around disruptions/api/test_notification_store.py -- from ci.yml's own
# step, or by hand -- and it drops its debug logs in whatever directory it was started from,
# which for that suite is disruptions/api/. firebase.json, firestore.rules and
# firestore.indexes.json ARE committed: the last of those is also what terraform/firestore.tf
# materialises every composite index from.
**/firebase-debug.log
**/firestore-debug.log
**/ui-debug.log
**/pubsub-debug.log
.firebase/
